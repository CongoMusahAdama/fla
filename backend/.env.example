MONGO_URI=your_mongodb_connection_string_here
JWT_SECRET=your_jwt_secret_key_here
PORT=3001

# Brevo (Sendinblue) Email — sender email MUST match a verified sender in Brevo dashboard
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_NAME=FLA Purchase
BREVO_SENDER_EMAIL=security@flamingo-store1.com

# mNotify SMS Configuration (https://readthedocs.mnotify.com/)
# - Add API key from mNotify dashboard → API Keys
# - Sender ID must be approved (max 11 chars), e.g. FLA or FLAMINGO
# - OTP codes use standard SMS by default (same route as welcome messages).
# - Set MNOTIFY_USE_OTP_ROUTE=true only if mNotify enables sms_type "otp" on your account.
# MNOTIFY_USE_OTP_ROUTE=false
# - On Render: set these in Environment, redeploy backend (fla-be)
MNOTIFY_API_KEY=your_mnotify_api_key_here
MNOTIFY_SENDER_ID=FLA

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Cloudflare Turnstile (must match frontend site key — never commit real secrets)
# Production: paste secret from Cloudflare dashboard.
# Local + Cloudflare "always pass" test site key: set TURNSTILE_DEV_BYPASS=true
# (or set the matching test secret from Cloudflare's Turnstile testing docs — do not commit it).
CLOUDFLARE_TURNSTILE_SECRET_KEY=your_turnstile_secret_key
TURNSTILE_DEV_BYPASS=true

# Paystack Configuration
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret_here
