# Copy to .env.local for local dev, or set these in the Vercel dashboard
# (Project → Settings → Environment Variables) for production builds.

# Backend API (NestJS on Render). Include the /api suffix.
NEXT_PUBLIC_API_URL=https://fla-be.onrender.com/api

# Cloudflare Turnstile (public site key — safe to expose; use your real key or Cloudflare's test site key)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Cloudinary cloud name (public — used to build image URLs)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dp9lv8q5e

# Stream Chat (dispute chat) — set your public key
NEXT_PUBLIC_STREAM_API_KEY=your_stream_api_key

# Support/report email (defaults to fadilansalifu58@gmail.com until domain mail is live)
NEXT_PUBLIC_FLA_REPORT_EMAIL=fadilansalifu58@gmail.com
NEXT_PUBLIC_FLA_SUPPORT_EMAIL=fadilansalifu58@gmail.com

# Customer "Report to FLA" → admin WhatsApp (optional; has a default)
NEXT_PUBLIC_FLA_ADMIN_WHATSAPP=0505112925
